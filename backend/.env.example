# "smtp" sends real mail, "log" writes it to storage/ (mail.log and an .html preview per mail type)
MAIL_DRIVER=log
MAIL_TO=YOUR_RECIPIENT_EMAIL_HERE
MAIL_FROM=YOUR_SENDER_EMAIL_HERE
MAIL_FROM_NAME=CicaŐr
SMTP_HOST=YOUR_SMTP_HOST_HERE
# 587 with tls (STARTTLS) or 465 with ssl
SMTP_PORT=587
SMTP_ENCRYPTION=tls
SMTP_USERNAME=YOUR_SMTP_USERNAME_HERE
SMTP_PASSWORD=YOUR_SMTP_PASSWORD_HERE
ALLOWED_ORIGINS=http://localhost:3000
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_SECONDS=3600
